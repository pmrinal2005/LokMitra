# ─── REQUIRED ────────────────────────────────────────────────
# https://agent.tinyfish.ai/api-keys  (server-side only, never exposed to the browser)
TINYFISH_API_KEY=

# ─── OPTIONAL INTEGRATIONS (app degrades gracefully without them) ─────────────
# Groq — multi-intent NLU, synthesis, Indic translation (qwen/qwen3-8b-27b). Without it: keyword intent + offline glossary.
GROQ_API_KEY=
# GROQ_MODEL_HEAVY=openai/gpt-oss-120b
# GROQ_MODEL_MID=openai/gpt-oss-20b
# GROQ_MODEL_LIGHT=qwen/qwen3-8b-27b
# GROQ_MODEL_TRANSLATE=qwen/qwen3-8b-27b

# Telegram bot (BotFather). After deploy: POST /api/telegram/setup (with ADMIN_TOKEN) to register the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Resend — Citizen Benefit Report e-mails + sentinel alerts
RESEND_API_KEY=
RESEND_FROM=LokMitra <onboarding@resend.dev>

# Supabase — persistent reports / audit log / sessions / sentinels (NO cache tables). Run supabase/migrations/*.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── DEPLOYMENT / SECURITY ───────────────────────────────────
# Public URL used in report QR codes, e-mails and Telegram webhook (auto-detected on Vercel)
PUBLIC_BASE_URL=
# Protects paid/operator actions (Agent runs, monitor creation). Empty = open (dev only)
ADMIN_TOKEN=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/maintenance
CRON_SECRET=
SESSION_SECRET=
WEBHOOK_SECRET=

# Wall-clock safety cap (seconds) per Agent run — a timeout guard, NOT a budget cap. 0 = no cap
TINYFISH_MAX_DURATION_SECONDS=180
# TINYFISH_AGENT_MODE=default      # "strict" requires TinyFish /beta enrolment
# TINYFISH_SEND_MAX_STEPS=1        # only if your account has the "custom max steps" beta
