# ─── REQUIRED ────────────────────────────────────────────────
# Get one at https://agent.tinyfish.ai/api-keys  (server-side only, never exposed to the browser)
TINYFISH_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────
# Budget ceiling drawn on the wallet gauge (USD)
DECK_BUDGET_USD=5
# Hard cap (seconds) applied to every Agent run launched from the deck, protects the wallet. 0 = no cap
TINYFISH_MAX_DURATION_SECONDS=180
# Override upstream base URLs (rarely needed)
# TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
# TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai
# TINYFISH_BROWSER_BASE_URL=https://api.browser.tinyfish.ai
